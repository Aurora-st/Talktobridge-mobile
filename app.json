{
  "expo": {
    "name": "TalkBridge AI",
    "slug": "talkbridge-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "talkbridge",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talkbridge.ai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TalkBridge AI needs microphone access to record your voice for translation.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.talkbridge.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "TalkBridge AI needs microphone access to record your voice for translation.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "9dac37ea-b0f6-4d3c-9a03-5e76fd5b05b9"
      }
    }
  }
}
